# Google Photos OAuth
GPHOTO_CREDENTIALS_FILE=credentials.json

# Directories
STAGING_DIR=./staging
OUTPUT_DIR=./output
UNRESOLVED_DIR=./output/unresolved

# API keys
ASTROMETRY_API_KEY=
GEMINI_API_KEY=

# AI model (must be a valid Gemini model name)
AI_VISION_MODEL=gemini-2.5-flash

# Behavior
DRY_RUN=false
PLATE_SOLVE_TIMEOUT_SECONDS=180
SKIP_EXISTING=true
DOWNLOAD_CACHE_FILE=./output/download_cache.json
